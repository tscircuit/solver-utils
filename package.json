{
  "name": "@tscircuit/solver-utils",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/solver-utils.git"
  },
  "main": "dist/index.js",
  "version": "0.0.25",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js",
    "./runtime/node": "./dist/runtime/node.js",
    "./runtime/bun": "./dist/runtime/bun.js"
  },
  "type": "module",
  "scripts": {
    "start": "cosmos",
    "build": "tsup-node ./lib/index.ts ./lib/runtime/node.ts ./lib/runtime/bun.ts --format esm --dts --clean -d dist && tsup-node ./lib/react/index.ts --format esm --dts -d dist/react",
    "build:site": "cosmos-export",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@react-hook/resize-observer": "^2.0.2",
    "@types/bun": "latest",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19",
    "graphics-debug": "^0.0.76",
    "react": "^19.1.1",
    "react-cosmos": "^7.0.0",
    "react-cosmos-plugin-vite": "^7.0.0",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "graphics-debug": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
