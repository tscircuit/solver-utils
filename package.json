{
  "name": "@tscircuit/solver-utils",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/solver-utils.git"
  },
  "main": "dist/index.js",
  "version": "0.0.21",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "cosmos",
    "build": "bun run build:styles && tsup-node ./lib/index.ts --format esm --dts -d dist && tsup-node ./lib/react/index.ts --format esm --dts -d dist/react",
    "build:styles": "bun scripts/build-debugger-styles.ts && biome format --write lib/react/debugger-styles.generated.ts",
    "build:site": "cosmos-export",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@react-hook/resize-observer": "^2.0.2",
    "@types/bun": "latest",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "graphics-debug": "^0.0.76",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-cosmos": "^7.0.0",
    "react-cosmos-plugin-vite": "^7.0.0",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.0",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "graphics-debug": "*"
  }
}
